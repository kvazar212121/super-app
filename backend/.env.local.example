# =============================================================================
# Super App — lokal ish (Docker'siz, scripts/start-local.sh)
# =============================================================================
# Ishlatish:  cp .env.local.example .env.local
# =============================================================================

APP_NAME=SuperApp
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/superapp
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5435/superapp
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=local-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=*
CORS_ALLOW_ALL=true

# Admin panel login
ADMIN_DEFAULT_PHONE=admin
ADMIN_DEFAULT_PASSWORD=admin123

# Dev: OTP kodini API javobida ko'rsatish mumkin
BYPASS_AUTH=false
REQUIRE_OTP_AUTH=false
OTP_DEV_EXPOSE=true

SMS_PROVIDER=console
DEVSMS_BASE_URL=https://devsms.uz/api
DEVSMS_TOKEN=
DEVSMS_SENDER=4546
DEVSMS_CALLBACK_URL=
SMS_OTP_TEMPLATE=PROWORKER mobil ilovasidan ro'yxatdan o'tish uchun tasdiqlash kodi: {code}

MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
CASHBACK_RATE=1.0

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
