# =============================================================================
# Super App — muhit o'zgaruvchilari (shablon)
# =============================================================================
# Ishlatish:
#   Docker:  cp .env.example .env
#   Lokal:   cp .env.local.example .env.local
# Production parollarni gitga commit qilmang.
# =============================================================================

# --- Ilova ---
APP_NAME=SuperApp
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Ma'lumotlar bazasi (Docker: host=db, Lokal: host=localhost port=5435) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/superapp
DATABASE_SYNC_URL=postgresql://postgres:postgres@db:5432/superapp
REDIS_URL=redis://redis:6379/0

# --- Xavfsizlik (productionda albatta o'zgartiring) ---
SECRET_KEY=super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=*
CORS_ALLOW_ALL=true

# --- Admin panel (birinchi marta ishga tushganda yaratiladi) ---
ADMIN_DEFAULT_PHONE=admin
ADMIN_DEFAULT_PASSWORD=admin123

# --- Auth / OTP ---
BYPASS_AUTH=false
REQUIRE_OTP_AUTH=true
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_VERIFICATION_TOKEN_MINUTES=10
OTP_DEV_EXPOSE=false

# --- SMS (dev: console, production: devsms yoki eskiz) ---
SMS_PROVIDER=console
DEVSMS_BASE_URL=https://devsms.uz/api
DEVSMS_TOKEN=
DEVSMS_SENDER=4546
DEVSMS_CALLBACK_URL=
SMS_OTP_TEMPLATE=PROWORKER mobil ilovasidan ro'yxatdan o'tish uchun tasdiqlash kodi: {code}
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

# --- Yuklash va cashback ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
CASHBACK_RATE=1.0

# --- Rate limit ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
