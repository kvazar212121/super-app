APP_NAME=SuperApp
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/superapp
REDIS_URL=redis://redis:6379/0
SECRET_KEY=super-secret-key-change-in-production
ENVIRONMENT=development
CORS_ORIGINS=*

# Auth — production uchun
BYPASS_AUTH=false
REQUIRE_OTP_AUTH=true
OTP_DEV_EXPOSE=false

# SMS — devsms.uz (https://devsms.uz/api)
SMS_PROVIDER=devsms
DEVSMS_BASE_URL=https://devsms.uz/api
DEVSMS_TOKEN=your-devsms-bearer-token-here
DEVSMS_SENDER=4546
DEVSMS_CALLBACK_URL=
SMS_OTP_TEMPLATE=PROWORKER mobil ilovasidan ro'yxatdan o'tish uchun tasdiqlash kodi: {code}
