# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
  end

  # firebase_messaging 14.x imports the non-modular <Firebase/Firebase.h> umbrella header
  # from a *public* header (FLTFirebaseMessagingPlugin.h). Xcode's framework-module
  # verification rejects that regardless of build settings. Rewrite the import to the
  # specific modular headers the plugin actually needs (FIRApp + FIRMessagingDelegate).
  # Idempotent and re-applied on every `pod install`, so the build stays reproducible.
  Dir.glob(File.expand_path('~/.pub-cache/hosted/pub.dev/firebase_messaging-*/ios/Classes/FLTFirebaseMessagingPlugin.h')).each do |header|
    contents = File.read(header)
    patched = contents.gsub(
      '#import <Firebase/Firebase.h>',
      "#import <FirebaseCore/FirebaseCore.h>\n#import <FirebaseMessaging/FirebaseMessaging.h>")
    if patched != contents
      File.write(header, patched)
      Pod::UI.puts "Patched non-modular Firebase.h import in #{File.basename(header)}"
    end
  end
end

# Xcode 16 does not schedule CocoaPods' aggregate target (`Pods-Runner`) as an implicit
# dependency of `Runner`, so `ld` looks for a framework nobody built:
#     ld: framework 'Pods_Runner' not found
# The aggregate holds nothing but CocoaPods' dummy symbol — every real pod is already
# linked through OTHER_LDFLAGS and copied by [CP] Embed Pods Frameworks (the aggregate is
# absent from Pods-Runner-frameworks-*-input-files.xcfilelist) — so drop the phantom link.
# Must run in post_integrate: post_install fires *before* the client project is
# integrated, and integration would put the link straight back.
post_integrate do |installer|
  installer.aggregate_targets.each do |aggregate_target|
    removed = false
    aggregate_target.user_targets.each do |user_target|
      phase = user_target.frameworks_build_phase
      phase.files.to_a.each do |build_file|
        name = build_file.display_name.to_s
        next unless name =~ /\APods_.+\.framework\z/
        phase.remove_build_file(build_file)
        removed = true
        Pod::UI.puts "Removed phantom #{name} link from #{user_target.name}"
      end
    end
    aggregate_target.user_project.save if removed
  end
end
